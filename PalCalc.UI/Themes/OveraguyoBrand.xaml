<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="OveraguyoSkyColor">#69C8FF</Color>
    <Color x:Key="OveraguyoBlueColor">#2878C8</Color>
    <Color x:Key="OveraguyoNavyColor">#101A32</Color>
    <Color x:Key="OveraguyoPanelColor">#E6172948</Color>
    <Color x:Key="OveraguyoStarColor">#FFD86A</Color>

    <SolidColorBrush x:Key="OveraguyoSkyBrush" Color="{StaticResource OveraguyoSkyColor}" />
    <SolidColorBrush x:Key="OveraguyoBlueBrush" Color="{StaticResource OveraguyoBlueColor}" />
    <SolidColorBrush x:Key="OveraguyoNavyBrush" Color="{StaticResource OveraguyoNavyColor}" />
    <SolidColorBrush x:Key="OveraguyoPanelBrush" Color="{StaticResource OveraguyoPanelColor}" />
    <SolidColorBrush x:Key="OveraguyoStarBrush" Color="{StaticResource OveraguyoStarColor}" />

    <LinearGradientBrush x:Key="OveraguyoHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EF101A32" Offset="0" />
        <GradientStop Color="#E92878C8" Offset="0.7" />
        <GradientStop Color="#D669C8FF" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="OveraguyoPillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource OveraguyoBlueBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
</ResourceDictionary>
