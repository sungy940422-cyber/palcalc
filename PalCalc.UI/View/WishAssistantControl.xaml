<UserControl x:Class="PalCalc.UI.View.WishAssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340" Height="150"
             IsHitTestVisible="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>

        <Border Margin="0,12,0,22" Padding="15,12" CornerRadius="16"
                BorderBrush="{StaticResource OveraguyoSkyBrush}" BorderThickness="2"
                Background="#F21A2742">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="WISH" Foreground="{StaticResource OveraguyoSkyBrush}"
                               FontWeight="Bold" FontSize="13" />
                    <Button DockPanel.Dock="Right" Content="×" Width="23" Height="23"
                            Padding="0" Command="{Binding HideWishAssistantCommand}"
                            ToolTip="위시 숨기기" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding WishMessage}" Foreground="White"
                           TextWrapping="Wrap" FontSize="14" Margin="0,7,0,5" />
                <TextBlock Grid.Row="2" Text="{Binding WishMoodLabel}"
                           Foreground="#A9DFFF" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- 위시: 소원별 병 요정, 팔은 정확히 두 개 -->
        <Viewbox Grid.Column="1" Width="116" Height="140" VerticalAlignment="Bottom">
            <Canvas Width="120" Height="145">
                <Ellipse Canvas.Left="18" Canvas.Top="30" Width="88" Height="96"
                         Fill="#E8F7FF" Stroke="#78BFFF" StrokeThickness="3" />
                <Ellipse Canvas.Left="27" Canvas.Top="40" Width="70" Height="72"
                         Fill="#C9EAFF" Opacity="0.38" />
                <Rectangle Canvas.Left="39" Canvas.Top="13" Width="48" Height="24"
                           RadiusX="5" RadiusY="5" Fill="#D6AA71" Stroke="#254B85" StrokeThickness="3" />
                <Path Data="M 80,30 C 104,21 111,39 91,48 C 112,58 99,73 79,52 Z"
                      Fill="#345D9D" Stroke="#1E3E73" StrokeThickness="2" />
                <Path Data="M 91,44 L 101,58" Stroke="#FFD86A" StrokeThickness="3" />
                <Path Data="M 101,52 L 104,57 L 110,58 L 106,63 L 107,69 L 101,66 L 96,69 L 97,63 L 93,58 L 99,57 Z"
                      Fill="#FFD86A" Stroke="#E2AC32" StrokeThickness="1" />
                <!-- two arms -->
                <Path Data="M 24,78 C 9,75 5,67 2,59" Stroke="#E8F7FF" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 100,78 C 113,73 116,63 117,55" Stroke="#E8F7FF" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Canvas.Left="38" Canvas.Top="65" Width="10" Height="14" Fill="#274A7C" />
                <Ellipse Canvas.Left="78" Canvas.Top="65" Width="10" Height="14" Fill="#274A7C" />
                <Ellipse Canvas.Left="40" Canvas.Top="67" Width="3" Height="4" Fill="White" />
                <Ellipse Canvas.Left="80" Canvas.Top="67" Width="3" Height="4" Fill="White" />
                <Path Data="M 54,83 Q 63,92 72,83" Stroke="#E6788E" StrokeThickness="3" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Canvas.Left="29" Canvas.Top="82" Width="14" Height="8" Fill="#FFB7C8" Opacity="0.7" />
                <Ellipse Canvas.Left="83" Canvas.Top="82" Width="14" Height="8" Fill="#FFB7C8" Opacity="0.7" />
                <Path Data="M 52,100 L 57,108 L 67,109 L 60,116 L 62,126 L 52,121 L 43,126 L 45,116 L 38,109 L 48,108 Z"
                      Fill="#70C8FF" Stroke="#347FC0" StrokeThickness="2" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
