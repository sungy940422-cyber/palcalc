<UserControl x:Class="PalCalc.UI.View.WishAssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" Height="190"
             IsHitTestVisible="True">
    <Grid ClipToBounds="False" UseLayoutRounding="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>

        <Border Margin="0,38,0,22" Padding="15,12" CornerRadius="16"
                BorderBrush="{StaticResource OveraguyoSkyBrush}" BorderThickness="2"
                Background="#F21A2742">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="WISH" Foreground="{StaticResource OveraguyoSkyBrush}"
                               FontWeight="Bold" FontSize="13" />
                    <Button DockPanel.Dock="Right" Content="×" Width="23" Height="23"
                            Padding="0" Command="{Binding HideWishAssistantCommand}"
                            ToolTip="위시 숨기기" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding WishMessage}" Foreground="White"
                           TextWrapping="Wrap" FontSize="14" Margin="0,7,0,5" />
                <TextBlock Grid.Row="2" Text="{Binding WishMoodLabel}"
                           Foreground="#A9DFFF" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- 설정표를 기준으로 제작한 고해상도 위시 UI 일러스트 -->
        <Image Grid.Column="1"
               Width="148" Height="168"
               Margin="0,0,2,14"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Uniform"
               ClipToBounds="False"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality"
               Source="/PalCalc.UI;component/Resources/Brand/WishAssistant.png" />
    </Grid>
</UserControl>
