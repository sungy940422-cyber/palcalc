<UserControl x:Class="PalCalc.UI.View.WishAssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" Height="170"
             IsHitTestVisible="True">
    <Grid ClipToBounds="False" UseLayoutRounding="True">
        <Border Margin="0,10,0,10" Padding="10" CornerRadius="16"
                BorderBrush="{StaticResource OveraguyoSkyBrush}" BorderThickness="2"
                Background="#F21A2742">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 위시를 말풍선 안에 배치해 화면 배율과 창 크기에 관계없이 전신이 보이게 한다. -->
                <Image Grid.Column="0"
                       Width="126" Height="132"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="None"
                       SnapsToDevicePixels="True"
                       Source="/PalCalc.UI;component/Resources/Brand/WishAssistantSmall.png" />

                <Grid Grid.Column="1" Margin="8,2,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="WISH · FIX 6" Foreground="{StaticResource OveraguyoSkyBrush}"
                                   FontWeight="Bold" FontSize="13" />
                        <Button DockPanel.Dock="Right" Content="×" Width="23" Height="23"
                                Padding="0" Command="{Binding HideWishAssistantCommand}"
                                ToolTip="위시 숨기기" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding WishMessage}" Foreground="White"
                               TextWrapping="Wrap" FontSize="14" Margin="0,7,0,5" />
                    <TextBlock Grid.Row="2" Text="{Binding WishMoodLabel}"
                               Foreground="#A9DFFF" FontSize="10" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
